<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.apache.ibatis.type.ClassConstructorTypeHandlerTest">

  <resultMap id="credentialMap" type="org.apache.ibatis.type.ClassConstructorTypeHandlerTest$Credential">
    <id property="id" column="id"/>
    <result property="name" column="name"
        typeHandler="org.apache.ibatis.type.ClassConstructorTypeHandlerTest$ClassOnlyJsonTypeHandler"/>
    <result property="data" column="data"
        typeHandler="org.apache.ibatis.type.ClassConstructorTypeHandlerTest$ClassOnlyJsonTypeHandler"/>
    <result property="tags" column="tags"
        typeHandler="org.apache.ibatis.type.ClassConstructorTypeHandlerTest$ClassOnlyJsonTypeHandler"/>
    <result property="metadata" column="metadata"
        typeHandler="org.apache.ibatis.type.ClassConstructorTypeHandlerTest$TypeConstructorJsonTypeHandler"/>
    <result property="explicitData" column="explicit_data" javaType="java.util.Map"
        typeHandler="org.apache.ibatis.type.ClassConstructorTypeHandlerTest$ClassOnlyJsonTypeHandler"/>
  </resultMap>

  <select id="select" resultMap="credentialMap">
    select id, name, data, tags, metadata, explicit_data from credential
  </select>

</mapper>
